{
  "name": "dsh-shared-browser",
  "version": "0.6.11",
  "description": "Turnkey browser for DeepSeek Harness: a shared Browser tab plus an external Edge/Chrome channel, with an agent-facing tool surface, element comments, console/network capture, screenshots, region screenshots and a built-in DevTools panel.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./lib/client.cjs"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/",
    "locale/",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README_en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "browser",
    "webview",
    "external-browser",
    "cdp",
    "msedge",
    "chrome",
    "devtools",
    "screenshot",
    "comment",
    "shared-browser"
  ],
  "license": "MIT",
  "author": {
    "name": "FeiGenb",
    "url": "https://github.com/FeiGenb"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeiGenb/dsh-shared-browser.git"
  },
  "homepage": "https://github.com/FeiGenb/dsh-shared-browser#readme",
  "bugs": {
    "url": "https://github.com/FeiGenb/dsh-shared-browser/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-browser",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "prepublishOnly": "node scripts/publish-guard.mjs"
  }
}
